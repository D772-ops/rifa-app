# ===== Copia este archivo como .env y completa tus datos =====

# Puerto del servidor
PORT=3000

# URL publica donde queda desplegada la app (sin barra final).
# Mercado Pago necesita esta URL para enviar la notificacion del pago (webhook).
# Ej: https://mirifa.onrender.com
PUBLIC_URL=http://localhost:3000

# Clave de administrador: se pide para entrar a /admin.
# Cambiala por una dificil de adivinar.
ADMIN_PASSWORD=cambia-esta-clave

# ===== Mercado Pago =====
# Access Token de PRODUCCION (o de PRUEBA para testear).
# Lo obtienes en: https://www.mercadopago.com -> Tu negocio -> Credenciales.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx

# ===== Datos de la rifa (valores iniciales, luego editables desde /admin) =====
RAFFLE_NAME=Rifa Diaria
CURRENCY=COP
PRICE=5000
DRAW_TIME=20:00
RELEASE_MINUTES=60
